# Use a general Stripe Sandbox. Never commit real secret keys.
STRIPE_SECRET_KEY=sk_test_or_rkcs_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Payment Element requires Stripe API version 2026-03-25.dahlia or newer.
STRIPE_API_VERSION=2026-03-25.dahlia
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_replace_me
STRIPE_ONE_TIME_PRICE_ID=price_replace_me
STRIPE_SUBSCRIPTION_PRICE_ID=price_replace_me

# Run `stripe listen --forward-to localhost:4242/webhook` and copy its whsec_ value.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
